<script>
  function initGlitch() {
    const hero = document.getElementById("hero-container");
    const baseAscii = document.getElementById("home-ascii");
    const glitchAscii = document.getElementById("home-ascii-glitch");

    if (!hero || !baseAscii || !glitchAscii) return;

    const rawText = baseAscii.textContent || "";
    const glitchChars = [".", ":", "'", "*", "+", "#", "%", "?", "/", "\\", "░", "▒", "▓"];

    function triggerGlitch() {
      const lines = rawText.split("\n");
      const numMutations = Math.floor(Math.random() * 8) + 2;

      for (let i = 0; i < numMutations; i++) {
        const lineIdx = Math.floor(Math.random() * lines.length);
        const line = lines[lineIdx];
        if (!line || line.length === 0) continue;
        const charIdx = Math.floor(Math.random() * line.length);
        const randomChar = glitchChars[Math.floor(Math.random() * glitchChars.length)];
        lines[lineIdx] =
          line.substring(0, charIdx) + randomChar + line.substring(charIdx + 1);
      }

      glitchAscii.textContent = lines.join("\n");

      const shiftX = (Math.random() * 6 - 3).toFixed(1) + "px";
      const shiftY = (Math.random() * 2 - 1).toFixed(1) + "px";
      const clipTop = Math.floor(Math.random() * 70) + "%";
      const clipBottom = Math.floor(Math.random() * 20) + "%";

      glitchAscii.style.setProperty("--ascii-glitch-shift-x", shiftX);
      glitchAscii.style.setProperty("--ascii-glitch-shift-y", shiftY);
      glitchAscii.style.setProperty("--ascii-glitch-clip-top", clipTop);
      glitchAscii.style.setProperty("--ascii-glitch-clip-bottom", clipBottom);

      hero.classList.add("is-glitching");

      const duration = Math.floor(Math.random() * 80) + 30;
      setTimeout(() => {
        hero.classList.remove("is-glitching");
        scheduleNext();
      }, duration);
    }

    function scheduleNext() {
      const nextInterval = Math.floor(Math.random() * 5000) + 1500;
      setTimeout(triggerGlitch, nextInterval);
    }

    scheduleNext();
  }

  function initFitScale() {
    const shell = document.querySelector(".home-shell") as HTMLElement | null;
    const fitScope = document.querySelector("[data-textmode-fit-scope]") as HTMLElement | null;
    if (!shell || !fitScope) return;

    function calculateFit() {
      const mobileMatches = window.innerWidth <= 760;
      if (!mobileMatches) {
        fitScope?.style.setProperty("--fit-scale", "1");
        return;
      }

      const pres = shell?.querySelectorAll("pre") || [];
      let maxChars = 0;
      pres.forEach((pre) => {
        const lines = (pre.textContent || "").split("\n");
        lines.forEach((line) => {
          if (line.length > maxChars) maxChars = line.length;
        });
      });

      const contentWidth = maxChars * 8 + 40;
      const viewportWidth = document.documentElement.clientWidth || window.innerWidth;
      const scale = Math.min(1, viewportWidth / Math.max(1, contentWidth));
      fitScope?.style.setProperty("--fit-scale", scale.toFixed(4));
    }

    window.addEventListener("resize", calculateFit, { passive: true });
    calculateFit();
  }

  function initParticles() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const chars = [".", ".", "·", "·", ":", "'", "*"];
    let layer = document.querySelector(".ascii-particles") as HTMLDivElement | null;
    if (!layer) {
      layer = document.createElement("div");
      layer.className = "ascii-particles";
      layer.setAttribute("aria-hidden", "true");
      document.body.append(layer);
    }

    const isMobile = window.innerWidth <= 760;
    const count = isMobile ? 38 : 86;
    const particles: Array<{
      element: HTMLSpanElement;
      x: number;
      y: number;
      driftX: number;
      driftY: number;
      opacity: number;
      phase: number;
      phaseStep: number;
    }> = [];

    let width = window.innerWidth;
    let height = window.innerHeight;

    for (let i = 0; i < count; i++) {
      const span = document.createElement("span");
      span.textContent = chars[Math.floor(Math.random() * chars.length)] ?? ".";
      layer.appendChild(span);

      particles.push({
        element: span,
        x: Math.random() * width,
        y: Math.random() * height,
        driftX: Math.random() * 0.56 - 0.28,
        driftY: -(Math.random() * 0.52 + 0.2),
        opacity: Math.random() * 0.32 + 0.3,
        phase: Math.random() * Math.PI * 2,
        phaseStep: Math.random() * 0.055 + 0.03,
      });
    }

    let pointerX = Number.NaN;
    let pointerY = Number.NaN;

    window.addEventListener("pointermove", (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
    }, { passive: true });

    window.addEventListener("pointerleave", () => {
      pointerX = Number.NaN;
      pointerY = Number.NaN;
    }, { passive: true });

    let lastTime = performance.now();

    function animate(time: number) {
      const delta = Math.min(64, time - lastTime) / 16.67;
      lastTime = time;

      for (const p of particles) {
        p.x += p.driftX * delta;
        p.y += p.driftY * delta;
        p.phase += p.phaseStep * delta;

        if (!Number.isNaN(pointerX) && !Number.isNaN(pointerY)) {
          const dx = p.x - pointerX;
          const dy = p.y - pointerY;
          const distSq = dx * dx + dy * dy;
          const radius = 150;
          if (distSq < radius * radius) {
            const dist = Math.sqrt(distSq);
            const force = ((1 - dist / radius) ** 2) * delta;
            const unitX = dist > 0 ? dx / dist : Math.cos(p.phase);
            const unitY = dist > 0 ? dy / dist : Math.sin(p.phase);
            p.x += unitX * force * 1.8;
            p.y += unitY * force * 1.2;
          }
        }

        if (p.y < -24) p.y = height + 24;
        if (p.y > height + 24) p.y = -24;
        if (p.x < -24) p.x = width + 24;
        if (p.x > width + 24) p.x = -24;

        const flicker = 0.72 + Math.sin(time * 0.0017 + p.phase) * 0.28;
        p.element.style.opacity = (p.opacity * flicker).toFixed(3);
        p.element.style.transform = `translate3d(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px, 0)`;
      }

      requestAnimationFrame(animate);
    }

    window.addEventListener("resize", () => {
      width = window.innerWidth;
      height = window.innerHeight;
    }, { passive: true });

    requestAnimationFrame(animate);
  }

  function initAll() {
    initGlitch();
    initFitScale();
    initParticles();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
</script>
